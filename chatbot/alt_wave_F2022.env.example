# alt_wave_F2022.env.example — Fall 2022 alt-wave override settings (v60, 2026-10-30)
#
# NOT loaded automatically. To activate for one run:
#   export $(grep -v '^#' chatbot/alt_wave_F2022.env.example | xargs)
#   python chatbot/run_orchestrator_eval.py --only <case-id>
# Then unset the vars when done (or restart shell).
#
# Paths are relative to the project root (parent of chatbot/).
# The cluster_tool and lift_tool read these env vars directly; no CHATBOT_DIR join.

CLUSTER_RESULTS_FILE_OVERRIDE=chatbot/data/alt_wave_F2022/clust_ensembled_results_F2022.csv
LIFT_TABLE_FILE_OVERRIDE=chatbot/data/alt_wave_F2022/skill_lift_table_F2022.csv
FREQ_WAVE_OVERRIDE=F2022
DATA_WAVE_LABEL=Fall 2022 (F2022)
MEMBERSHIP_CONFIDENCE_FILE_OVERRIDE=chatbot/data/alt_wave_F2022/cluster_membership_confidence_F2022.csv
# v60b2: FOCUSED_CLUSTERS_OVERRIDE no longer needed — the rule (_compute_focused_clusters) computes
# {3,4,8,10} for F2022 automatically (≥20 skills, ≥90% technical, median freq ≥0.1%).
# Uncomment only if you need to hand-override the computed set for a specific run.
# FOCUSED_CLUSTERS_OVERRIDE=3,4,8,10
CLUSTER_THEMES_OVERRIDE_JSON=PENDING_ERIC  # fill from Eric-vetted F2022 labels
