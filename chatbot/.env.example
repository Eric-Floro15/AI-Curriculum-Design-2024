# Copy this file to .env and fill in your actual API keys.
# Never commit .env to version control.

# Select the LLM provider: openai | anthropic | gemini
LLM_PROVIDER=openai

# OpenAI (required for embeddings regardless of LLM_PROVIDER)
OPENAI_API_KEY=sk-...

# Anthropic (required if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini (required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=...
