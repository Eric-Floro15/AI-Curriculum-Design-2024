# Copy this file to .env and fill in your actual API keys.
# Never commit .env to version control.

# ── LLM (agents) ──────────────────────────────────────────────────────────────
# Provider: anthropic (default) | openai | gemini | ollama
LLM_PROVIDER=anthropic
# Model id. Defaults per provider: claude-sonnet-4-6 / gpt-4o /
# gemini-1.5-pro / llama3.1:8b. Override to use a different model.
LLM_MODEL=claude-sonnet-4-6

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...

# ── Embeddings (FAISS index + RAG query) ──────────────────────────────────────
# Provider: ollama (default, local, free) | openai
# IMPORTANT: build_index.py and rag_tool.py must use the same provider/model,
# or FAISS retrieval returns garbage. Both import from chatbot/embeddings.py.
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBED_MODEL=mxbai-embed-large
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_EMBED_MODEL=text-embedding-3-small

# ── Ollama context window (only relevant when LLM_PROVIDER=ollama) ───────────
# Ollama's own default (4096) can silently truncate long prompts. This
# project's agent backstories + injected RAG content can get long, so a
# larger context window is recommended. HOWEVER: this is NOT a variable to
# set in this .env file — chatbot/llm.py deliberately does not pass num_ctx
# to crewai.LLM() for Ollama models, after it broke crew.kickoff() twice
# with `TypeError: Completions.create() got an unexpected keyword argument
# 'num_ctx'` (a CrewAI-internal-routing issue — see CLAUDE.md, "Ollama
# Context Window", for the full history).
#
# Set it on the Ollama SERVER process instead, e.g.:
#   OLLAMA_CONTEXT_LENGTH=8192 ollama serve
# Or, if Ollama runs as the macOS menu-bar app (not a manually-run `ollama
# serve`):
#   launchctl setenv OLLAMA_CONTEXT_LENGTH 8192
#   (then restart the Ollama app)
# Confirmed real Ollama env var per https://docs.ollama.com/faq ("How can I
# specify the context window size?"). Not yet live-confirmed by this
# project that raising it actually reduces crash rates — the original
# truncation hypothesis is still unverified.
