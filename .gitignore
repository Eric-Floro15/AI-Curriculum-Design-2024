# Reference / example folders — kept locally only, not committed.
# News-Agent-Chatbot-Code-Example contains a third-party .env with a
# real OpenAI API key — DO NOT commit.
News-Agent-Chatbot-Code-Example/

# macOS junk
.DS_Store

# Office/Word lock files (e.g. ~$foo.docx, .~foo.docx)
.~*
~$*

# Env files anywhere in the repo (defence in depth — chatbot/.gitignore
# also covers chatbot/.env; final_implementation/.env was found tracked
# and untracked on 2026-09-17, see git log for that path). Explicit
# **/ form covers every subdirectory, not just root-level; .env.example
# templates are intentionally re-allowed.
.env
**/.env
**/.env.*
!**/.env.example

# Claude Cowork session files
.claude/

# Chainlit runtime config (auto-generated on first run)
chatbot/.chainlit/
